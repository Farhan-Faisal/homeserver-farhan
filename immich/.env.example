# Copy to .env, then edit.  Full list of options: https://docs.immich.app/install/environment-variables

# Where photos and videos go. Put this on your big drive.
UPLOAD_LOCATION=/srv/data/immich

# Where the database goes. Keep it on the SSD (it's small but busy). Never a network share.
DB_DATA_LOCATION=./postgres

# Your time zone, e.g. Asia/Dhaka, Europe/London, America/New_York
TZ=Etc/UTC

# Major version to follow. Change only when you deliberately upgrade (read the release notes first).
IMMICH_VERSION=v3

# Database password: letters and digits only. README.md shows how to generate one.
DB_PASSWORD=change-me

# Leave these as they are
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
