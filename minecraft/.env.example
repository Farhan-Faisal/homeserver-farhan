# Copy to .env, then edit.

# Container name. Commands in README.md use it; serverdash's "minecraft_container" must match it.
CONTAINER_NAME=project-architect

# Must match the modpack: Minecraft version and the Forge version the pack was built for
MC_VERSION=1.20.1
FORGE_VERSION=47.4.8

# Java memory. MAX_MEMORY = what the pack needs (modded packs: 8-12G).
# MEM_LIMIT = MAX_MEMORY + about 2G for Java's own overhead.
INIT_MEMORY=4G
MAX_MEMORY=10G
MEM_LIMIT=12g

# Minecraft usernames, comma-separated
WHITELIST=YourName,FriendName
OPS=YourName

# World seed (empty = random)
SEED=

# Your time zone, e.g. Asia/Dhaka, Europe/London, America/New_York
TZ=Etc/UTC
