# Copy to .env, then edit.

# Your user and group IDs: run `id -u` and `id -g`
PUID=1000
PGID=1000

# ID of the "render" group, for the Intel GPU: run `getent group render | cut -d: -f3`
RENDER_GID=992

# The folder holding movies/, tv/, music/
MEDIA_DIR=/srv/data/media

# Your time zone, e.g. Asia/Dhaka, Europe/London, America/New_York
TZ=Etc/UTC
