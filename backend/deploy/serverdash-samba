#!/bin/bash
# The one thing the API may run as root: list Samba users, or add one.
#   serverdash-samba list
#   serverdash-samba add <username>      (the password comes in on standard input, one line)
# Exit codes: 0 done, 2 bad input, 3 user already exists, 1 anything else.
set -euo pipefail

FILES=/srv/data/files
GROUP=smbusers

case "${1:-}" in
  list)
    # pdbedit -L prints "name:uid:full name" per user; keep the names
    pdbedit -L | cut -d: -f1
    ;;

  add)
    name="${2:-}"
    # starts with a letter; then lowercase letters, digits or dashes; 2 to 32 characters
    if [[ ! "$name" =~ ^[a-z][a-z0-9-]{1,31}$ ]]; then
      echo "invalid username" >&2; exit 2
    fi
    # any existing account, including system ones like root or www-data
    if id "$name" &>/dev/null; then
      echo "user $name already exists" >&2; exit 3
    fi
    IFS= read -r password
    if (( ${#password} < 8 )); then
      echo "password must be at least 8 characters" >&2; exit 2
    fi

    # a Linux account that can't log in (no shell), in the Samba group
    useradd --no-create-home --home-dir "$FILES/$name" --shell /usr/sbin/nologin \
            --user-group --groups "$GROUP" "$name"
    # its Samba password; if that fails, remove the account again so nothing is half-made
    if ! printf '%s\n%s\n' "$password" "$password" | smbpasswd -a -s "$name" >/dev/null; then
      userdel "$name"; echo "couldn't set the Samba password" >&2; exit 1
    fi
    # its private folder
    install -d -o "$name" -g "$name" -m 700 "$FILES/$name"
    echo "created $name"
    ;;

  *)
    echo "usage: serverdash-samba list | add <username>  (password on standard input)" >&2; exit 2
    ;;
esac
